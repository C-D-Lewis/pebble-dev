{
  "name": "tube-status",
  "version": "3.16.0",
  "author": "Chris Lewis",
  "private": true,
  "dependencies": {
    "pebble-packet": "^1.6.1",
    "pebble-scalable": "^2.4.0"
  },
  "devDependencies": {
    "pkts": "^0.3.0-beta.1"
  },
  "scripts": {
    "build": "pkts build"
  },
  "keywords": [
    "pebble-app"
  ],
  "pebble": {
    "sdkVersion": "3",
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "SPANNER",
          "file": "images/spanner.png"
        },
        {
          "type": "bitmap",
          "name": "APP_ICON",
          "file": "images/app_icon.png",
          "menuIcon": true
        }
      ]
    },
    "projectType": "native",
    "uuid": "5120531c-9d73-4852-b26d-3d3cee90d92a",
    "messageKeys": [
      "LINE_TYPE",
      "LINE_STATUS",
      "LINE_REASON",
      "FLAG_IS_COMPLETE",
      "FLAG_LINE_COUNT"
    ],
    "enableMultiJS": true,
    "displayName": "Tube Status",
    "watchapp": {
      "onlyShownOnCommunication": false,
      "hiddenApp": false,
      "watchface": false
    },
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "gabbro"
    ],
    "capabilities": [],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": ["api.tfl.gov.uk"]
        },
        "reason": "To download TfL delay status data",
        "required": true
      }
    ]
  }
}
